PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=change_this_to_a_long_random_string_of_at_least_24_characters
ADMIN_PASSWORD=change_this_password
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5173,http://localhost:5174
PUBLIC_API_URL=http://localhost:4000
PUBLIC_SITE_URL=http://localhost:5173

# Keep both business numbers, international format, no + or spaces.
WHATSAPP_UK_NUMBER=447523864253
WHATSAPP_NG_NUMBER=2347397023326

# Cloudinary is strongly recommended in production. If blank, files are stored locally.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=inspired-munachimso-couture
MAX_UPLOAD_MB=80
MAX_CUSTOMER_UPLOAD_MB=12

# Payment providers: leave blank until business accounts are ready.
STRIPE_SECRET_KEY=
PAYSTACK_SECRET_KEY=

# Optional email setup: leave blank during development.
RESEND_API_KEY=
EMAIL_FROM=Inspiredmunachimso’s Couture <onboarding@resend.dev>
BUSINESS_EMAIL=
